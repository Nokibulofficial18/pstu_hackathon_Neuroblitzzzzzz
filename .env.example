# Environment Variables for NCash

# ─────────────────────────────────────────────────────────────────────────────
# REQUIRED — DO NOT commit real values to source control
# ─────────────────────────────────────────────────────────────────────────────

# PostgreSQL connection string (Supabase, local Docker, or managed PostgreSQL)
ConnectionStrings__DefaultConnection="Host=YOUR_HOST;Port=5432;Database=YOUR_DB;Username=YOUR_USER;Password=YOUR_PASSWORD;SSL Mode=Require;Trust Server Certificate=true"

# JWT signing secret — MUST be at least 32 characters; use a cryptographically random value
Jwt__Secret="REPLACE_WITH_SECURE_RANDOM_SECRET_MIN_32_CHARS"

# JWT configuration (optional — defaults shown below)
Jwt__Issuer="NCash"
Jwt__Audience="NCashUsers"
Jwt__ExpiryMinutes="60"

# ─────────────────────────────────────────────────────────────────────────────
# OPTIONAL
# ─────────────────────────────────────────────────────────────────────────────

# Comma-separated allowed CORS origins (required in production)
# Example: AllowedOrigins="https://app.yourdomain.com,https://api.yourdomain.com"
AllowedOrigins=""

# Set to true ONLY in Development/Test environments — seeds demo users
# Production MUST leave this false (or unset)
SeedDemoData="false"

# ─────────────────────────────────────────────────────────────────────────────
# DEVELOPMENT SETUP (using dotnet user-secrets)
# ─────────────────────────────────────────────────────────────────────────────
# cd src/NCash.Web
# dotnet user-secrets init
# dotnet user-secrets set "ConnectionStrings:DefaultConnection" "YOUR_LOCAL_CONN_STRING"
# dotnet user-secrets set "Jwt:Secret" "YOUR_SECURE_RANDOM_SECRET"
# dotnet user-secrets set "SeedDemoData" "true"
